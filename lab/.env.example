# Langfuse — 프로젝트 설정 > API Keys. 없으면 트레이스가 꺼진다
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # US: https://us.cloud.langfuse.com, JP: https://jp.cloud.langfuse.com

# 분류 모델 — 하나만 고른다. 아무것도 없으면 fake (네트워크 없이 늘 none 을 답함)
# Claude: Console(platform.claude.com)의 API 키. Claude 구독과는 별개로 과금된다
ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-5-5            # 기본 claude-opus-5-5

# OpenAI 호환 (Ollama 등). LLM_BASE_URL 이 있으면 Claude 보다 먼저 쓴다. fake 로 두면 강제 fake
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=
